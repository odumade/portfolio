# Public site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, the portfolio assistant calls an OpenAI-compatible chat API.
# Leave blank to use the built-in demo, which answers from src/data/portfolio.ts.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional. When set, the contact form POSTs JSON to this webhook.
# Leave blank to run the form in demo mode (validated, not stored).
CONTACT_WEBHOOK_URL=
